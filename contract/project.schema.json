    "operand": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "variable"
            },
            "variableId": {
              "type": "string",
              "format": "uuid"
            }
          },
          "required": [
            "kind",
            "variableId"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "literal"
            },
            "value": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer",
                  "minimum": -2147483648,
                  "maximum": 2147483647
                },
                {
                  "type": "boolean"
                }
              ]
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "day"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "$id": "https://storyflow.local/project.schema.json"
}
